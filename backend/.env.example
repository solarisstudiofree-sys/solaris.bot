# Copie ce fichier en ".env" et remplis les valeurs

PORT=3000

# Clé secrète utilisée pour signer les tokens JWT (mets une longue chaîne aléatoire)
JWT_SECRET=change_moi_avec_une_longue_chaine_aleatoire

# Clé API Anthropic utilisée par l'agent IA intégré aux bots
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Email + mot de passe du premier compte admin créé automatiquement au démarrage
ADMIN_EMAIL=solarisstudiofree@gmail.com
ADMIN_PASSWORD=Semisakyuz7979azerty.

# URL publique du site (utilisée dans les emails / liens générés)
PUBLIC_URL=http://localhost:3000

# Clé secrète utilisée pour signer les payloads envoyés aux webhooks clients (HMAC SHA256)
WEBHOOK_SIGNING_SECRET=change_moi_aussi

# --- PayPal (paiements réels) --------------------------------------------
# Crée une app sur https://developer.paypal.com/dashboard/applications pour
# obtenir ces identifiants. Commence par "sandbox" pour tester sans vrai argent.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR
